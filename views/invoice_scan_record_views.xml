<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- ============================================================ -->
        <!-- TREE VIEW -->
        <!-- ============================================================ -->
        <record id="view_invoice_scan_record_tree" model="ir.ui.view">
            <field name="name">invoice.scan.record.tree</field>
            <field name="model">invoice.scan.record</field>
            <field name="arch" type="xml">
                <!-- js_class : met en couleur vive les lignes en doublon
                     (static/src/scan_list). -->
                <tree string="Scans de factures" js_class="invoice_scan_list"
                      decoration-success="state=='done'" 
                      decoration-danger="state=='error'" decoration-muted="state=='draft'"
                      decoration-bf="state=='processed'"
                      decoration-warning="document_type=='refund'">
                    <header>
                        <button name="action_mark_processed" type="object"
                                string="✅ Marquer traité(s)"
                                class="btn-primary"/>
                        <button name="action_mark_unprocessed" type="object"
                                string="↩ Remettre non traité(s)"
                                class="btn-secondary"/>
                        <!-- Traitement groupé : même sélection, mais avec
                             ventilation avant action et compte-rendu après.
                             C'est le chemin à privilégier sur un gros lot. -->
                        <button name="action_open_bulk_process_wizard" type="object"
                                string="⚙ Traitement groupé…"
                                class="btn-secondary"/>
                    </header>
                    <!-- Aperçu de la facture scannée, sans quitter la liste -->
                    <button name="action_preview_scan" type="object"
                            icon="fa-eye" title="Aperçu de la facture scannée"
                            class="btn-link o_scan_preview_button"/>
                    <!-- Identification -->
                    <field name="reference"/>
                    <field name="scan_date" string="Date scan" widget="date"/>
                    <!-- Nature : facture ou AVOIR. Colonne non masquable :
                         c'est l'information qui change le sens de la ligne. -->
                    <field name="document_type" string="Nature" widget="badge"
                           decoration-info="document_type == 'invoice'"
                           decoration-danger="document_type == 'refund'"/>
                    <!-- Fournisseur & Facture -->
                    <field name="supplier_name" string="Fournisseur"/>
                    <!-- Non masquable : c'est par ce numéro que les
                         utilisateurs cherchent une facture. -->
                    <field name="invoice_number_dgi" string="N° Facture DGI"/>
                    <field name="invoice_date" optional="hide"/>
                    <!-- Financier : on somme le montant SIGNÉ, jamais la valeur
                         absolue — sans quoi les avoirs gonflent le total. -->
                    <field name="amount_signed" string="Montant" sum="Net"
                           decoration-danger="amount_signed &lt; 0"/>
                    <field name="amount_ttc" string="Montant TTC (absolu)" optional="hide"/>
                    <field name="origin_invoice_number_dgi" string="Facture d'origine" optional="hide"/>
                    <field name="document_type_verified" string="Nature confirmée"
                           widget="boolean" optional="hide"/>
                    <field name="currency_id" column_invisible="1"/>
                    <!-- Statut & Traitement -->
                    <field name="state" widget="badge" 
                           decoration-success="state == 'done'"
                           decoration-danger="state == 'error'"
                           decoration-info="state == 'draft'"
                           decoration-warning="state == 'processed'"/>
                    <!-- Doublons : colonne NON masquable (pas d'attribut
                         « optional ») : chaque utilisateur la voit, sans
                         réglage. La ligne entière passe en couleur vive. -->
                    <field name="duplicate_count" string="Doublons"
                           decoration-danger="duplicate_count &gt; 0"
                           decoration-bf="duplicate_count &gt; 0"/>
                    <!-- Autre forme de doublon : une AUTRE facture enregistrée
                         porte le même numéro (même fournisseur). Non masquable
                         elle aussi. -->
                    <field name="same_number_count" string="Même n°"
                           decoration-danger="same_number_count &gt; 0"
                           decoration-bf="same_number_count &gt; 0"/>
                    <field name="is_processed" column_invisible="1"/>
                    <field name="processed_by" string="Traité par" optional="show"/>
                    <field name="processed_date" string="Traité le" widget="date" optional="hide"/>
                    <!-- Liens & Infos complémentaires -->
                    <field name="invoice_id" string="Facture Odoo" optional="show"/>
                    <field name="scanned_by" string="Scanné par" optional="hide"/>
                    <field name="is_manual_entry" string="Saisie manuelle" widget="boolean" optional="hide"/>
                    <!-- Actions par ligne -->
                    <button name="action_mark_processed" type="object"
                            string="✅ Traiter" title="Marquer comme traité"
                            icon="fa-check-circle"
                            invisible="state != 'done'"
                            class="btn-link text-success"/>
                    <button name="action_mark_unprocessed" type="object"
                            string="↩ Annuler" title="Remettre non traité"
                            icon="fa-undo"
                            invisible="state != 'processed'"
                            class="btn-link text-warning"/>
                </tree>
            </field>
        </record>

        <!-- ============================================================ -->
        <!-- FORM VIEW -->
        <!-- ============================================================ -->
        <record id="view_invoice_scan_record_form" model="ir.ui.view">
            <field name="name">invoice.scan.record.form</field>
            <field name="model">invoice.scan.record</field>
            <field name="arch" type="xml">
                <form string="Scan de facture QR">
                    <header>
                        <button name="action_mark_processed" string="✅ Marquer comme traité"
                                type="object" class="btn-primary"
                                invisible="state != 'done'"
                                confirm="Marquer ce scan comme traité/enregistré ?"/>
                        <button name="action_mark_unprocessed" string="↩ Remettre non traité"
                                type="object" class="btn-warning"
                                invisible="state != 'processed'"
                                confirm="Remettre ce scan à l'état 'Facture créée' ?"/>
                        <button name="action_retry_create_invoice" string="Réessayer création facture"
                                type="object" class="btn-primary"
                                invisible="state != 'error' or invoice_id"/>
                        <button name="action_preview_scan" string="Aperçu de la facture"
                                type="object" class="btn-secondary" icon="fa-eye"/>
                        <button name="action_view_invoice" string="Voir la pièce comptable"
                                type="object" class="btn-secondary"
                                invisible="not invoice_id"/>
                        <button name="action_verify_document_type"
                                string="Vérifier la nature auprès de la DGI"
                                type="object" class="btn-secondary"
                                invisible="document_type_verified"/>
                        <field name="state" widget="statusbar" statusbar_visible="draft,done,processed"/>
                    </header>
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button name="action_view_invoice" type="object" class="oe_stat_button"
                                    icon="fa-file-text-o" invisible="not invoice_id">
                                <field name="invoice_id" widget="statinfo" string="Pièce"/>
                            </button>
                            <button name="action_view_refunds" type="object" class="oe_stat_button"
                                    icon="fa-undo" invisible="refund_count == 0">
                                <field name="refund_count" widget="statinfo" string="Avoirs"/>
                            </button>
                        </div>
                        <!-- Un avoir n'est PAS une facture : il doit se voir
                             avant même de lire le montant. -->
                        <div class="alert alert-danger" role="alert"
                             invisible="document_type != 'refund'">
                            <strong><i class="fa fa-undo"/> AVOIR FOURNISSEUR</strong> —
                            créance sur le fournisseur, et non une dette.
                            La pièce comptable créée est un
                            <em>avoir fournisseur</em>, pas une facture d'achat.
                        </div>
                        <div class="alert alert-warning" role="alert"
                             invisible="document_type_verified or state == 'draft'">
                            <strong><i class="fa fa-question-circle"/> Nature non confirmée</strong> —
                            la nature de ce document (facture ou avoir) n'a pas été
                            confirmée par la plateforme DGI : elle a été déduite ou
                            saisie. Utilisez le bouton
                            « Vérifier la nature auprès de la DGI » avant comptabilisation.
                        </div>
                        <div class="oe_title">
                            <h1>
                                <field name="reference" readonly="1"/>
                            </h1>
                        </div>
                        <group>
                            <group string="Informations du scan">
                                <field name="qr_uuid" readonly="1"/>
                                <field name="qr_url" readonly="1" widget="url"/>
                                <field name="scan_date" readonly="1"/>
                                <field name="scanned_by" readonly="1"/>
                            </group>
                            <group string="Données DGI">
                                <field name="supplier_name" readonly="1"/>
                                <field name="supplier_code_dgi" readonly="1"/>
                                <field name="customer_name" readonly="1"/>
                                <field name="customer_code_dgi" readonly="1"/>
                            </group>
                        </group>
                        <group>
                            <group string="Document">
                                <field name="document_type" readonly="1"/>
                                <field name="document_type_verified" readonly="1"/>
                                <field name="invoice_number_dgi" readonly="1"/>
                                <field name="invoice_date" readonly="1"/>
                                <field name="verification_id" readonly="1"/>
                                <field name="amount_ttc" readonly="1"/>
                                <field name="amount_signed" readonly="1"/>
                                <field name="currency_id" readonly="1"/>
                                <field name="commercial_message" readonly="1" invisible="not commercial_message"/>
                            </group>
                            <group string="Résultat">
                                <field name="partner_id" readonly="1"/>
                                <field name="invoice_id" readonly="1"/>
                                <field name="company_id" groups="base.group_multi_company" readonly="1"/>
                            </group>
                        </group>
                        <group string="Rattachement de l'avoir"
                               invisible="document_type != 'refund'">
                            <group>
                                <field name="origin_invoice_number_dgi" readonly="1"/>
                                <field name="origin_scan_id" readonly="1"/>
                                <div colspan="2" class="text-muted"
                                     invisible="origin_scan_id or not origin_invoice_number_dgi">
                                    <i class="fa fa-info-circle"/>
                                    La facture d'origine n'a pas (encore) été scannée :
                                    le rattachement se fera automatiquement dès qu'elle le sera.
                                </div>
                            </group>
                        </group>
                        <group string="Même numéro de facture" invisible="same_number_count == 0">
                            <div colspan="2" class="alert alert-danger mb-0" role="alert">
                                <i class="fa fa-files-o"/>
                                <field name="same_number_count" readonly="1" class="fw-bold mx-1"/>
                                autre(s) facture(s) enregistrée(s) portent ce numéro
                                pour ce fournisseur :
                                <field name="same_number_refs" readonly="1" class="fw-bold"/>.
                                Vérifiez qu'elle n'est pas comptabilisée deux fois.
                            </div>
                        </group>
                        <group string="Tentatives de doublons" invisible="duplicate_count == 0">
                            <group>
                                <field name="duplicate_count" readonly="1"/>
                                <field name="last_duplicate_attempt" readonly="1"/>
                                <field name="last_duplicate_user_id" readonly="1"/>
                            </group>
                        </group>
                        <group string="Tentatives de retraitement" invisible="reprocess_attempt_count == 0">
                            <group>
                                <field name="reprocess_attempt_count" readonly="1"/>
                                <field name="last_reprocess_attempt" readonly="1"/>
                                <field name="last_reprocess_user_id" readonly="1"/>
                            </group>
                        </group>
                        <group string="Traitement" invisible="state not in ('done', 'processed')">
                            <group>
                                <field name="is_processed" readonly="1" widget="boolean_toggle"/>
                                <field name="processed_by" readonly="1" invisible="not processed_by"/>
                                <field name="processed_date" readonly="1" invisible="not processed_date"/>
                            </group>
                        </group>
                        <group string="Informations techniques">
                            <group>
                                <field name="verification_duration" readonly="1" 
                                       widget="float_time"
                                       invisible="verification_duration == 0"/>
                                <field name="is_manual_entry" readonly="1"/>
                            </group>
                        </group>
                        <group string="Erreur" invisible="state != 'error'">
                            <field name="error_message" readonly="1" nolabel="1" colspan="2"/>
                        </group>
                        <notebook groups="base.group_no_one">
                            <page string="Données brutes">
                                <field name="raw_html" readonly="1"/>
                            </page>
                        </notebook>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids"/>
                        <field name="activity_ids"/>
                        <field name="message_ids"/>
                    </div>
                </form>
            </field>
        </record>

        <!-- ============================================================ -->
        <!-- APERÇU (fenêtre ouverte par le bouton « œil » de la liste)   -->
        <!-- ============================================================ -->
        <record id="view_invoice_scan_record_preview_form" model="ir.ui.view">
            <field name="name">invoice.scan.record.preview.form</field>
            <field name="model">invoice.scan.record</field>
            <!-- Jamais la fiche par défaut : seulement sur demande. -->
            <field name="priority">99</field>
            <field name="arch" type="xml">
                <form string="Aperçu de la facture scannée"
                      create="0" edit="0" delete="0" duplicate="0">
                    <div class="alert alert-danger o_scan_preview_duplicate" role="alert"
                         invisible="duplicate_count == 0">
                        <strong><i class="fa fa-copy"/> DOUBLON</strong> —
                        cette facture a été présentée de nouveau
                        <field name="duplicate_count" readonly="1" class="fw-bold"/>
                        fois après son premier scan
                        <span invisible="not last_duplicate_attempt">
                            (dernière tentative le
                            <field name="last_duplicate_attempt" readonly="1"/>
                            <span invisible="not last_duplicate_user_id">
                                par <field name="last_duplicate_user_id" readonly="1"
                                           options="{'no_open': True}"/></span>)</span>.
                        Vérifiez qu'elle n'est pas payée deux fois.
                    </div>
                    <div class="alert alert-danger o_scan_preview_same_number" role="alert"
                         invisible="same_number_count == 0">
                        <strong><i class="fa fa-files-o"/> MÊME NUMÉRO DE FACTURE</strong> —
                        <field name="same_number_count" readonly="1" class="fw-bold"/>
                        autre(s) facture(s) enregistrée(s) portent ce numéro pour
                        ce fournisseur :
                        <field name="same_number_refs" readonly="1" class="fw-bold"/>.
                        Vérifiez qu'elle n'est pas comptabilisée deux fois.
                    </div>
                    <div class="alert alert-warning" role="alert"
                         invisible="document_type != 'refund'">
                        <strong><i class="fa fa-undo"/> AVOIR FOURNISSEUR</strong> —
                        créance sur le fournisseur, et non une dette.
                    </div>
                    <group>
                        <group string="Facture">
                            <field name="invoice_number_dgi" readonly="1"/>
                            <field name="supplier_name" readonly="1"/>
                            <field name="invoice_date" readonly="1"/>
                            <field name="amount_signed" readonly="1" string="Montant TTC"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="document_type" readonly="1"/>
                            <field name="origin_invoice_number_dgi" readonly="1"
                                   invisible="document_type != 'refund'"/>
                        </group>
                        <group string="Scan">
                            <field name="reference" readonly="1"/>
                            <field name="state" readonly="1" widget="badge"
                                   decoration-success="state == 'done'"
                                   decoration-danger="state == 'error'"
                                   decoration-info="state == 'draft'"
                                   decoration-warning="state == 'processed'"/>
                            <field name="scan_date" readonly="1"/>
                            <field name="scanned_by" readonly="1" options="{'no_open': True}"/>
                            <field name="processed_by" readonly="1" options="{'no_open': True}"
                                   invisible="not processed_by"/>
                            <field name="is_manual_entry" readonly="1"
                                   invisible="not is_manual_entry"/>
                            <field name="invoice_id" invisible="1"/>
                        </group>
                    </group>
                    <field name="dgi_preview_url" widget="dgi_invoice_preview"
                           nolabel="1" readonly="1"/>
                    <footer>
                        <button string="Fermer" special="cancel" class="btn-primary"
                                data-hotkey="x"/>
                        <button name="action_open_scan_form" type="object"
                                string="Ouvrir la fiche du scan" class="btn-secondary"/>
                        <button name="action_view_invoice" type="object"
                                string="Voir la pièce comptable" class="btn-secondary"
                                invisible="not invoice_id"/>
                    </footer>
                </form>
            </field>
        </record>

        <!-- ============================================================ -->
        <!-- SEARCH VIEW -->
        <!-- ============================================================ -->
        <record id="view_invoice_scan_record_search" model="ir.ui.view">
            <field name="name">invoice.scan.record.search</field>
            <field name="model">invoice.scan.record</field>
            <field name="arch" type="xml">
                <search string="Rechercher un scan">
                    <!-- Premier champ = recherche par défaut : taper un numéro
                         (même partiel) puis Entrée suffit. Il couvre la
                         référence du scan, le numéro DGI, la facture d'origine
                         d'un avoir, l'identifiant de vérification et la pièce
                         comptable. -->
                    <field name="number_search" string="Numéro (facture, scan, pièce)"/>
                    <field name="reference"/>
                    <field name="supplier_name"/>
                    <field name="invoice_number_dgi"/>
                    <field name="qr_uuid"/>
                    <field name="scanned_by"/>
                    <field name="origin_invoice_number_dgi"/>
                    <separator/>
                    <filter string="Factures" name="filter_invoice" domain="[('document_type', '=', 'invoice')]"/>
                    <filter string="Avoirs" name="filter_refund" domain="[('document_type', '=', 'refund')]"/>
                    <filter string="Nature à confirmer" name="filter_type_unverified"
                            domain="[('document_type_verified', '=', False), ('state', 'in', ['done', 'processed'])]"/>
                    <filter string="Avoirs sans facture d'origine" name="filter_refund_orphan"
                            domain="[('document_type', '=', 'refund'), ('origin_scan_id', '=', False)]"/>
                    <separator/>
                    <filter string="Factures créées" name="filter_done" domain="[('state', '=', 'done')]"/>
                    <filter string="Traités" name="filter_processed" domain="[('state', '=', 'processed')]"/>
                    <filter string="Non traités (en attente)" name="filter_not_processed" domain="[('state', '=', 'done'), ('processed_by', '=', False)]"/>
                    <filter string="Erreurs" name="filter_error" domain="[('state', '=', 'error')]"/>
                    <filter string="Saisie manuelle" name="filter_manual" domain="[('is_manual_entry', '=', True)]"/>
                    <filter string="Avec doublons" name="filter_duplicate"
                            domain="['|', ('duplicate_count', '&gt;', 0), ('same_number_count', '&gt;', 0)]"/>
                    <filter string="Même numéro de facture" name="filter_same_number"
                            domain="[('same_number_count', '&gt;', 0)]"/>
                    <separator/>
                    <filter string="Aujourd'hui" name="filter_today" 
                            domain="[('scan_date', '>=', datetime.datetime.combine(context_today(), datetime.time(0,0,0)))]"/>
                    <filter string="Cette semaine" name="filter_week"
                            domain="[('scan_date', '>=', (context_today() - datetime.timedelta(days=7)))]"/>
                    <filter string="Ce mois" name="filter_month"
                            domain="[('scan_date', '>=', datetime.datetime(context_today().year, context_today().month, 1))]"/>
                    <separator/>
                    <filter string="Mes scans" name="filter_mine" domain="[('scanned_by', '=', uid)]"/>
                    <group expand="0" string="Regrouper par">
                        <filter string="Nature du document" name="group_document_type" context="{'group_by': 'document_type'}"/>
                        <filter string="État" name="group_state" context="{'group_by': 'state'}"/>
                        <filter string="Fournisseur" name="group_supplier" context="{'group_by': 'supplier_name'}"/>
                        <filter string="Date du scan" name="group_date" context="{'group_by': 'scan_date:day'}"/>
                        <filter string="Scanné par" name="group_user" context="{'group_by': 'scanned_by'}"/>
                    </group>
                    <!-- Search Panel -->
                    <searchpanel>
                        <field name="document_type" icon="fa-files-o" select="one" enable_counters="1"/>
                        <field name="state" icon="fa-tasks" select="one" enable_counters="1"/>
                        <field name="scanned_by" icon="fa-user" select="multi" enable_counters="1"/>
                        <field name="partner_id" string="Fournisseur" icon="fa-building" select="multi" enable_counters="1"/>
                    </searchpanel>
                </search>
            </field>
        </record>

        <!-- ============================================================ -->
        <!-- KANBAN VIEW -->
        <!-- ============================================================ -->
        <record id="view_invoice_scan_record_kanban" model="ir.ui.view">
            <field name="name">invoice.scan.record.kanban</field>
            <field name="model">invoice.scan.record</field>
            <field name="arch" type="xml">
                <kanban class="o_kanban_mobile" sample="1">
                    <field name="id"/>
                    <field name="reference"/>
                    <field name="supplier_name"/>
                    <field name="amount_ttc"/>
                    <field name="currency_id"/>
                    <field name="state"/>
                    <field name="document_type"/>
                    <field name="amount_signed"/>
                    <field name="scan_date"/>
                    <field name="duplicate_count"/>
                    <field name="same_number_count"/>
                    <field name="is_processed"/>
                    <field name="is_manual_entry"/>
                    <field name="scanned_by"/>
                    <templates>
                        <t t-name="kanban-box">
                            <div t-attf-class="oe_kanban_global_click #{(record.duplicate_count.raw_value > 0 or record.same_number_count.raw_value > 0) ? 'o_scan_kanban_duplicate' : ''}">
                                <div class="o_kanban_record_top mb-2">
                                    <div class="o_kanban_record_headings">
                                        <strong class="o_kanban_record_title">
                                            <field name="reference"/>
                                        </strong>
                                    </div>
                                    <field name="state" widget="badge" 
                                           decoration-success="state == 'done'"
                                           decoration-warning="state == 'processed'"
                                           decoration-danger="state == 'error'"
                                           decoration-info="state == 'draft'"/>
                                </div>
                                <div class="o_kanban_record_body">
                                    <div t-if="record.document_type.raw_value == 'refund'"
                                         class="mb-1">
                                        <span class="badge text-bg-danger">
                                            <i class="fa fa-undo"/> AVOIR
                                        </span>
                                    </div>
                                    <div><strong><field name="supplier_name"/></strong></div>
                                    <div t-attf-class="mt-1 #{record.document_type.raw_value == 'refund' ? 'text-danger fw-bold' : 'text-muted'}">
                                        <field name="amount_signed" widget="monetary"/> 
                                        <field name="currency_id"/>
                                    </div>
                                    <div t-if="record.is_manual_entry.raw_value" class="text-info mt-1">
                                        <i class="fa fa-keyboard-o"/> Saisie manuelle
                                    </div>
                                    <div t-if="record.duplicate_count.raw_value > 0" class="mt-1">
                                        <span class="badge text-bg-danger">
                                            <i class="fa fa-copy" title="Doublon"/> Doublon × <field name="duplicate_count"/>
                                        </span>
                                    </div>
                                    <div t-if="record.same_number_count.raw_value > 0" class="mt-1">
                                        <span class="badge text-bg-danger">
                                            <i class="fa fa-files-o" title="Même numéro"/> Même n° de facture
                                        </span>
                                    </div>
                                    <div class="mt-1">
                                        <a type="object" name="action_preview_scan" role="button">
                                            <i class="fa fa-eye"/> Aperçu
                                        </a>
                                    </div>
                                </div>
                                <div class="o_kanban_record_bottom mt-2">
                                    <div class="oe_kanban_bottom_left text-muted">
                                        <i class="fa fa-clock-o" title="En attente"/> <field name="scan_date" widget="date"/>
                                    </div>
                                    <div class="oe_kanban_bottom_right text-muted">
                                        <i class="fa fa-user" title="Icône"/> <field name="scanned_by"/>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <!-- ============================================================ -->
        <!-- PIVOT VIEW -->
        <!-- ============================================================ -->
        <record id="view_invoice_scan_record_pivot" model="ir.ui.view">
            <field name="name">invoice.scan.record.pivot</field>
            <field name="model">invoice.scan.record</field>
            <field name="arch" type="xml">
                <pivot string="Analyse des scans" sample="1">
                    <field name="scan_date" type="row" interval="month"/>
                    <field name="document_type" type="col"/>
                    <field name="amount_signed" type="measure"/>
                </pivot>
            </field>
        </record>

        <!-- ============================================================ -->
        <!-- GRAPH VIEW -->
        <!-- ============================================================ -->
        <record id="view_invoice_scan_record_graph" model="ir.ui.view">
            <field name="name">invoice.scan.record.graph</field>
            <field name="model">invoice.scan.record</field>
            <field name="arch" type="xml">
                <graph string="Scans de factures" type="bar" sample="1">
                    <field name="scan_date" interval="day"/>
                    <field name="amount_signed" type="measure"/>
                </graph>
            </field>
        </record>

        <!-- ============================================================ -->
        <!-- ACTION -->
        <!-- ============================================================ -->
        <record id="action_invoice_scan_record" model="ir.actions.act_window">
            <field name="name">Scans de factures</field>
            <field name="res_model">invoice.scan.record</field>
            <field name="view_mode">tree,kanban,form,pivot,graph</field>
            <field name="search_view_id" ref="view_invoice_scan_record_search"/>
            <!-- Pas de filtre « Aujourd'hui » par défaut : un numéro tapé
                 dans la barre de recherche est cherché dans TOUT
                 l'historique. Les scans les plus récents restent en tête ;
                 « Aujourd'hui » est à un clic dans les filtres. -->
            <field name="context">{}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Aucun scan de facture à afficher
                </p>
                <p>
                    Tapez un numéro de facture (même seulement ses derniers
                    chiffres) dans la barre de recherche : la recherche porte
                    sur tout l'historique.
                </p>
                <p>
                    Les scans arrivent de l'application mobile ou du poste de
                    scan à la douchette.
                </p>
            </field>
        </record>

        <!-- ============================================================ -->
        <!-- SERVER ACTIONS (Mass actions) -->
        <!-- ============================================================ -->
        <record id="action_mark_processed_mass" model="ir.actions.server">
            <field name="name">Marquer comme traité(s)</field>
            <field name="model_id" ref="model_invoice_scan_record"/>
            <field name="binding_model_id" ref="model_invoice_scan_record"/>
            <field name="binding_view_types">list</field>
            <field name="state">code</field>
            <field name="code">records.action_mark_processed()</field>
        </record>

        <record id="action_verify_document_type_mass" model="ir.actions.server">
            <field name="name">Vérifier la nature auprès de la DGI</field>
            <field name="model_id" ref="model_invoice_scan_record"/>
            <field name="binding_model_id" ref="model_invoice_scan_record"/>
            <field name="binding_view_types">list,form</field>
            <field name="state">code</field>
            <field name="code">action = records.action_verify_document_type()</field>
        </record>

        <record id="action_mark_unprocessed_mass" model="ir.actions.server">
            <field name="name">Remettre non traité(s)</field>
            <field name="model_id" ref="model_invoice_scan_record"/>
            <field name="binding_model_id" ref="model_invoice_scan_record"/>
            <field name="binding_view_types">list</field>
            <field name="state">code</field>
            <field name="code">records.action_mark_unprocessed()</field>
        </record>

    </data>
</odoo>
